{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "test",
    "scripts",
    "../homerund/src/globals.d.ts"
  ],
  "exclude": [
    "test/e2e/dist",
    "test/e2e/results",
    "test/e2e/report"
  ]
}
