{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homerun",
  "version": "0.0.1",
  "identifier": "dev.homerun.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Homerun", "width": 720, "height": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/homerund", "binaries/claude", "binaries/node", "binaries/uv"],
    "resources": { "binaries/npm/": "npm/" },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["http://127.0.0.1:8799/latest.json"],
      "pubkey": "REPLACED_BY_PACKAGE_SH",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
