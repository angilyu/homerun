{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homerun",
  "version": "0.0.1",
  "identifier": "com.angilyu.homerun",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "pnpm run dev:tauri",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Homerun",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 480,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:5178; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "HOMERUN_UPDATER_PUBKEY_NOT_SET",
      "endpoints": ["https://github.com/angilyu/homerun/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/homerund", "binaries/claude"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  }
}
