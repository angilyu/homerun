{
  "name": "@homerun/homerund",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --minify --sourcemap ./src/main.ts --outfile ./dist/homerund",
    "typecheck": "tsc -p .",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:replay": "bun test test/replay",
    "record": "HOMERUN_REPLAY=record bun test test/replay"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@homerun/core": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
