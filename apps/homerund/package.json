{
  "name": "@homerun/homerund",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv --minify --sourcemap ./src/main.ts --outfile ./dist/homerund",
    "build:dev": "bun build --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv --sourcemap --define 'HOMERUND_BUILD=\"development\"' ./src/main.ts --outfile ./dist/homerund-dev",
    "dev": "bun run scripts/dev-shell.ts",
    "typecheck": "tsc -p .",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:replay": "bun test test/replay",
    "test:crash": "bun test test/crash",
    "test:remote": "bun test test/remote",
    "record": "HOMERUN_REPLAY=record bun test test/replay"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@homerun/client": "workspace:*",
    "@homerun/core": "workspace:*",
    "@homerun/protocol": "workspace:*",
    "@homerun/remote": "workspace:*",
    "@homerun/win32": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@homerun/relay": "workspace:*",
    "@homerun/testkit": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
