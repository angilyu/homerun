{
  "name": "@homerun/ios",
  "private": true,
  "version": "0.0.1",
  "description": "The iPhone app (\u00a79.8): React Native views on @homerun/app-state over the relay, with keys, tokens, pushes and Face ID in native Swift (HomerunKit) and a Notification Service Extension.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --platform ios --clean --no-install",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "bun test test",
    "test:swift": "cd modules/homerun/ios/HomerunKit && swift test",
    "test:hermes": "bun scripts/hermes-vectors.ts"
  },
  "dependencies": {
    "@homerun/app-state": "workspace:*",
    "@homerun/core": "workspace:*",
    "@homerun/protocol": "workspace:*",
    "@homerun/remote": "workspace:*",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "expo": "57.0.24",
    "expo-build-properties": "57.0.21",
    "expo-camera": "57.0.5",
    "expo-constants": "57.0.19",
    "expo-dev-client": "57.0.19",
    "expo-local-authentication": "57.0.3",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "1.11.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@homerun/homerund": "workspace:*",
    "@homerun/relay": "workspace:*",
    "@homerun/testkit": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
}
