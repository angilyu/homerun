{
  "name": "@homerun/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Homerun relay (§9.4): a Cloudflare Worker with one SQLite-backed Durable Object per account, plus a Bun adapter running the same core for tests and local development.",
  "exports": {
    ".": "./src/index.ts",
    "./local": "./src/local.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "bun test test/local",
    "test:workerd": "bun test test/workerd",
    "dev": "bun run src/local-main.ts"
  },
  "dependencies": {
    "@homerun/core": "workspace:*",
    "@homerun/protocol": "workspace:*",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@homerun/testkit": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "wrangler": "4.137.0"
  }
}
